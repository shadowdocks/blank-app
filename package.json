{
  "name": "hawk-streamlit",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "cloud": "bun run scripts/streamlit-cloud.ts",
    "dev": "vite",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --target ESNext --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck scripts/streamlit-cloud.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vidstack/react": "1.15.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
