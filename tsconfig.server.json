{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["src/server.ts", "src/access-log.ts", "src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/client", "**/*.test.ts", "**/*.test.tsx"]
}
